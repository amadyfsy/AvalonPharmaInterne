# Modèle .env PythonAnywhere — compte DMS07
# Ne JAMAIS faire `source .env` dans bash : le $ du nom de base serait mangé.
# Python charge ce fichier via load_dotenv().

SECRET_KEY=changez-moi
SECURITY_PASSWORD_SALT=changez-moi
ENCRYPTION_KEY=changez-moi

# Préféré sur PythonAnywhere (évite le problème du $)
MYSQL_USER=DMS07
MYSQL_PASSWORD=VOTRE_MOT_DE_PASSE_MYSQL
MYSQL_HOST=DMS07.mysql.pythonanywhere-services.com
MYSQL_DATABASE=DMS07$Avalon_pharma

FLASK_CONFIG=production
TALISMAN_FORCE_HTTPS=true
PUBLIC_CORS_ORIGINS=https://avalonpharma.pythonanywhere.com
MAIL_SUPPRESS_SEND=true
COMPANY_NAME=Avalon Pharma Senegal
