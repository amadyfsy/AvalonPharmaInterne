# Modèle .env pour PythonAnywhere — compte DMS07
# Copier sur le serveur : cp deploy/env.dms07.example .env && nano .env
# Ne jamais committer .env avec le vrai mot de passe

SECRET_KEY=GENERER_AVEC_python_-c_"import_secrets;print(secrets.token_hex(32))"
SECURITY_PASSWORD_SALT=GENERER_16_octets_hex
ENCRYPTION_KEY=GENERER_FERNET

# Mot de passe MySQL = celui défini dans l'onglet Databases de PythonAnywhere
DATABASE_URL=mysql+pymysql://DMS07:VOTRE_MOT_DE_PASSE_MYSQL@DMS07.mysql.pythonanywhere-services.com/DMS07%24Avalon_pharma?charset=utf8mb4

FLASK_CONFIG=production
TALISMAN_FORCE_HTTPS=true
PUBLIC_CORS_ORIGINS=https://votre-projet.vercel.app

MAIL_SUPPRESS_SEND=true
MAIL_DEFAULT_SENDER=noreply@avalon-pharma.sn
COMPANY_NAME="Avalon Pharma Senegal"
