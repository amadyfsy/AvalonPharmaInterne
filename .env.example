# Copier vers .env et remplir (ne jamais committer .env)

# --- Obligatoire en production ---
SECRET_KEY=changez-moi-avec-openssl-rand-hex-32
SECURITY_PASSWORD_SALT=changez-moi-avec-openssl-rand-hex-16
ENCRYPTION_KEY=changez-moi-fernet-44-chars-base64

# --- Base de données ---
# PythonAnywhere (compte DMS07) — remplacez MOT_DE_PASSE_MYSQL par votre mot de passe PA Databases
# Le $ dans le nom de base doit être encodé %24 dans l'URL :
# DATABASE_URL=mysql+pymysql://DMS07:MOT_DE_PASSE_MYSQL@DMS07.mysql.pythonanywhere-services.com/DMS07%24Avalon_pharma?charset=utf8mb4
#
# Docker local :
DATABASE_URL=mysql+pymysql://avalon:avalon-strong-password@db:3306/medical_erp?charset=utf8mb4

MYSQL_ROOT_PASSWORD=root-strong-password
MYSQL_DATABASE=medical_erp
MYSQL_USER=avalon
MYSQL_PASSWORD=avalon-strong-password

# --- Application ---
FLASK_CONFIG=production
API_PORT=5050
TALISMAN_FORCE_HTTPS=true
PUBLIC_CORS_ORIGINS=https://votre-projet.vercel.app

# --- SMTP (optionnel) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@avalon-pharma.sn
MAIL_SUPPRESS_SEND=true

COMPANY_NAME="Avalon Pharma Senegal"
