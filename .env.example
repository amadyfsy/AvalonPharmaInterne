# Copier vers .env et remplir avec des valeurs fortes (ne jamais committer .env)

# --- Obligatoire en production ---
SECRET_KEY=changez-moi-avec-openssl-rand-hex-32
SECURITY_PASSWORD_SALT=changez-moi-avec-openssl-rand-hex-16
ENCRYPTION_KEY=changez-moi-fernet-44-chars-base64

# Génération rapide :
# python -c "import secrets; print(secrets.token_hex(32))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Base de données Docker ---
MYSQL_ROOT_PASSWORD=root-strong-password
MYSQL_DATABASE=medical_erp
MYSQL_USER=avalon
MYSQL_PASSWORD=avalon-strong-password

# --- Application ---
FLASK_CONFIG=production
WEB_PORT=8080
API_PORT=5050
TALISMAN_FORCE_HTTPS=false
PUBLIC_CORS_ORIGINS=http://localhost:8080
COMPANY_NAME=Avalon Pharma Senegal

# --- SMTP (optionnel) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@avalon-pharma.sn
MAIL_SUPPRESS_SEND=true
